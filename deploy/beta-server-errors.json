{
  "displayName":"Visa beta server errors",
  "combiner":"OR",
  "enabled":true,
  "conditions":[{
    "displayName":"More than two server errors in five minutes",
    "conditionThreshold":{
      "filter":"resource.type=\"cloud_run_revision\" AND resource.labels.service_name=\"korea-visa-rag\" AND metric.type=\"run.googleapis.com/request_count\" AND metric.labels.response_code_class=\"5xx\"",
      "comparison":"COMPARISON_GT","thresholdValue":2,"duration":"0s",
      "aggregations":[{"alignmentPeriod":"300s","perSeriesAligner":"ALIGN_SUM","crossSeriesReducer":"REDUCE_SUM"}]
    }
  }],
  "notificationChannels":[]
}
