# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Your Gemini API key: https://aistudio.google.com/apikey
# Leave it empty to run in free search-only mode (BM25 search + sources, no AI answer).
GEMINI_API_KEY=

# Set true to disable Gemini calls even with a key saved. Uses free BM25 search.
SEARCH_ONLY=false

# Chat model used to write answers. Check https://ai.google.dev/gemini-api/docs/models
# for the current small/cheap model and put its name here.
GEMINI_CHAT_MODEL=gemini-3.5-flash-lite

# Text-only embedding model. Rebuild the index after changing this.
# Other models may need different batch handling in llm.py.
GEMINI_EMBED_MODEL=gemini-embedding-001

# Free key ("OC" value) from the Korean law Open API: https://open.law.go.kr
# Only needed if you run scripts/fetch_laws.py
LAW_API_OC=

# Telegram bot token: message @BotFather on Telegram, send /newbot, copy the token.
# Only needed for: python -m visarag.telegram_bot
TELEGRAM_BOT_TOKEN=

# Deployment settings. Use a persistent writable volume for generated data.
# VISARAG_DATA_DIR=/var/lib/visarag
# VISARAG_RAW_DIR=/app/data/public_raw
API_REQUESTS_PER_MINUTE=20
API_DAILY_AI_REQUESTS=100
API_MAX_CONCURRENT_AI=2

# Optional smaller real-Kiwi profile for 512 MB free hosting. Local default stays false.
KIWI_LIGHTWEIGHT=false

# Cloud Run only: immutable public-corpus snapshot in a private bucket.
# All three are required together; no service-account JSON keys are needed.
# VISARAG_SNAPSHOT_URI=gs://YOUR_BUCKET/releases/SHA256.json
# VISARAG_SNAPSHOT_GENERATION=OBJECT_GENERATION
# VISARAG_SNAPSHOT_SHA256=SHA256

# Proposed public beta. Requires approved prefix-only runtime write access first.
# Usage URI stores counts/timestamps only; never point it at releases or documents.
# VISARAG_PUBLIC_BETA=true
# VISARAG_USAGE_URI=gs://YOUR_BUCKET/usage/public-beta
API_DAILY_REQUESTS=500
