# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Your OpenAI API key: https://platform.openai.com/api-keys
# Leave it empty to run in free search-only mode (BM25 search + sources, no AI answer).
OPENAI_API_KEY=

# Chat model used to write answers. Check https://platform.openai.com/docs/models
# for the current small/cheap model and put its name here.
OPENAI_CHAT_MODEL=gpt-4o-mini

# Embedding model used for vector search
OPENAI_EMBED_MODEL=text-embedding-3-small

# Free key ("OC" value) from the Korean law Open API: https://open.law.go.kr
# Only needed if you run scripts/fetch_laws.py
LAW_API_OC=

# Telegram bot token: message @BotFather on Telegram, send /newbot, copy the token.
# Only needed for: python -m visarag.telegram_bot
TELEGRAM_BOT_TOKEN=
