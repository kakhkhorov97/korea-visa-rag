# Copy this file to `.env` and fill in your values. Never commit `.env`.

# Your Gemini API key: https://aistudio.google.com/apikey
# Leave it empty to run in free search-only mode (BM25 search + sources, no AI answer).
GEMINI_API_KEY=

# Set true to disable Gemini calls even with a key saved. Uses free BM25 search.
SEARCH_ONLY=false

# Chat model used to write answers. Check https://ai.google.dev/gemini-api/docs/models
# for the current small/cheap model and put its name here.
GEMINI_CHAT_MODEL=gemini-flash-latest

# Text-only embedding model. Rebuild the index after changing this.
# Other models may need different batch handling in llm.py.
GEMINI_EMBED_MODEL=gemini-embedding-001

# Free key ("OC" value) from the Korean law Open API: https://open.law.go.kr
# Only needed if you run scripts/fetch_laws.py
LAW_API_OC=

# Telegram bot token: message @BotFather on Telegram, send /newbot, copy the token.
# Only needed for: python -m visarag.telegram_bot
TELEGRAM_BOT_TOKEN=
